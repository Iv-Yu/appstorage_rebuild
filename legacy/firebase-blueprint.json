{
  "entities": {
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Master data suku cadang dan aset IT gudang",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "barcode": { "type": "string" },
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "quantity": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "unit": { "type": "string" },
        "location": { "type": "string" },
        "specs": { "type": "string" },
        "unitCost": { "type": "number" },
        "lastUpdated": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "sku", "name", "categoryId", "quantity", "unit", "location"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Log riwayat mutasi barang masuk dan keluar tiket lapangan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["IN", "OUT"] },
        "itemId": { "type": "string" },
        "itemSku": { "type": "string" },
        "itemName": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "date": { "type": "string" },
        "referenceType": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "performedBy": { "type": "string" },
        "recipientOrDestination": { "type": "string" },
        "notes": { "type": "string" },
        "apiSource": { "type": "string" }
      },
      "required": ["id", "type", "itemId", "itemSku", "quantity", "date", "referenceNumber"]
    },
    "Category": {
      "title": "Category",
      "description": "Kategori pengelompokan suku cadang",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "code": { "type": "string" }
      },
      "required": ["id", "name", "code"]
    },
    "SyncQueueAction": {
      "title": "SyncQueueAction",
      "description": "Antrean aksi offline yang disinkronkan ke cloud",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actionType": { "type": "string" },
        "payload": { "type": "object" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "actionType", "timestamp", "status"]
    }
  },
  "firestore": {
    "/workspaces/{workspaceId}/items/{itemId}": {
      "schema": "InventoryItem",
      "description": "Koleksi data suku cadang per workspace"
    },
    "/workspaces/{workspaceId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Koleksi riwayat mutasi transaksi per workspace"
    },
    "/workspaces/{workspaceId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "Koleksi kategori inventori per workspace"
    },
    "/workspaces/{workspaceId}/sync_queue/{queueId}": {
      "schema": "SyncQueueAction",
      "description": "Koleksi antrean sinkronisasi offline per workspace"
    }
  }
}
