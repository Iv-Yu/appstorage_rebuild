rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions for security and authentication
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Workspaces hierarchy - accessible only by authenticated users (SEC-01)
    match /workspaces/{workspaceId} {
      allow read, write: if isSignedIn() && isValidId(workspaceId);

      match /items/{itemId} {
        allow read, write: if isSignedIn() && isValidId(itemId);
      }

      match /transactions/{transactionId} {
        allow read, write: if isSignedIn() && isValidId(transactionId);
      }

      match /categories/{categoryId} {
        allow read, write: if isSignedIn() && isValidId(categoryId);
      }

      match /trash/{trashId} {
        allow read, write: if isSignedIn() && isValidId(trashId);
      }

      match /checklists/{checklistId} {
        allow read, write: if isSignedIn() && isValidId(checklistId);
      }

      match /sync_queue/{queueId} {
        allow read, write: if isSignedIn() && isValidId(queueId);
      }

      match /inspections/{inspectionId} {
        allow read, write: if isSignedIn() && isValidId(inspectionId);
      }
    }

    // Diagnostic connection self-test document (permits read for client health checks)
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
