# Server & App Config
PORT=3000
NODE_ENV=production
APP_SECRET_KEY=buat_kunci_rahasia_internal_super_panjang_dan_acak_disini

# Database MariaDB Server Kantor
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=fieldops_inventory
DB_USER=fieldops_user
DB_PASSWORD=buat_password_database_user_disini
DB_ROOT_PASSWORD=buat_password_root_mariadb_disini

# WhatsApp Gateway (Fonnte) Config
WHATSAPP_API_TOKEN=
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_TARGET_PHONES=
WHATSAPP_AUTO_ALERT=true

# Cloudflare Tunnel Token (Optional: Akses Remote HTTPS Atasan)
CLOUDFLARE_TUNNEL_TOKEN=